{
  "name": "dsh-env-doctor",
  "version": "0.1.0",
  "description": "Local first-run environment checks for DeepSeek Harness: Node, DSH_HOME, profile files, writability, sessions, and API-key presence.",
  "type": "module",
  "bin": { "dsh-env-doctor": "bin/dsh-env-doctor.mjs" },
  "exports": { ".": "./plugin/index.js", "./doctor": "./src/doctor.mjs", "./plugin": "./plugin/index.js", "./icon": "./icon.svg" },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "doctor", "setup", "environment"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-env-doctor" }
}
